[Unit]
Description=Kejian classroom timetable
After=network.target

[Service]
Type=simple
User=kejian
Group=kejian
WorkingDirectory=/opt/kejian/current
EnvironmentFile=/etc/kejian/runtime.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/kejian/venv/bin/gunicorn --bind 127.0.0.1:18027 --workers 1 --threads 4 --timeout 30 --no-control-socket classroom.app:production()
Restart=on-failure
RestartSec=5
StateDirectory=kejian
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kejian
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
CPUQuota=50%
TasksMax=40

[Install]
WantedBy=multi-user.target
